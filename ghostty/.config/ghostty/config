theme = Catppuccin Mocha
font-feature = -calt, -liga, -dlig
font-family = Hack Nerd Font Mono 
link-url = true

# splits control
keybind = performable:ctrl+shift+-=new_split:down
keybind = performable:ctrl+shift+|=new_split:right

keybind = performable:ctrl+shift+k=goto_split:up
keybind = performable:ctrl+shift+j=goto_split:down
keybind = performable:ctrl+shift+h=goto_split:left
keybind = performable:ctrl+shift+l=goto_split:right

keybind = performable:ctrl+shift+enter=toogle_split_zoom

keybind = performable:ctrl+shift+equal=equalize_splits

keybind = performable:ctrl+shift+up=resize_split:up,20
keybind = performable:ctrl+shift+down=resize_split:down,20
keybind = performable:ctrl+shift+left=resize_split:left,20
keybind = performable:ctrl+shift+right=resize_split:right,20

